rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Authentication & Role Helpers ─────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return hasUserDoc() ? getUserData().role : null;
    }

    function status() {
      return hasUserDoc() ? getUserData().status : null;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isAgent() {
      return isSignedIn() && role() == 'agent';
    }

    function isCustomer() {
      return isSignedIn() && role() == 'customer';
    }

    function isApproved() {
      return isSignedIn() && (status() == 'approved' || isAdmin());
    }

    // Development rules intentionally remain open for account switching.
    // firestore.production.rules is a separate fail-closed release guard; do not
    // deploy it until trusted order writers and the emulator matrix are complete.

    // ─── Users Collection ──────────────────────────────────────────
    // Users can read/update their own profile.
    // Unauthenticated reads permitted for phone login lookups.
    // Customers/agents cannot change role or status.
    // Agents can update their own isOnline status.
    // Admin has full access.

    match /users/{userId} {
      allow read, write: if true;
    }

    // ─── Items (Catalogue / Inventory) ─────────────────────────────
    match /items/{itemId} {
      allow read: if true;
      allow write: if !isSignedIn() || isAdmin();
    }

    // Legacy inventory collection support
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if !isSignedIn() || isAdmin();
    }

    // ─── Settings & Banners ────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if !isSignedIn() || isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if !isSignedIn() || isAdmin();
    }

    // Legacy offers collection support
    match /offers/{offerId} {
      allow read: if true;
      allow write: if !isSignedIn() || isAdmin();
    }

    // ─── QR Codes ──────────────────────────────────────────────────
    match /qr_codes/{qrId} {
      allow read: if true;
      allow write: if !isSignedIn() || isAdmin() || isAgent();
    }

    // ─── Stats Daily ───────────────────────────────────────────────
    match /stats_daily/{docId} {
      allow read, write: if true;
    }

    // ─── Orders ────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if !isSignedIn() || isAdmin() ||
        (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isAgent() && resource.data.agentId == request.auth.uid);

      allow create: if !isSignedIn() || isAdmin() || (
        isCustomer() &&
        isApproved() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'placed' &&
        request.resource.data.paymentMethod == 'COD'
      );

      allow update: if !isSignedIn() || isAdmin() || (
        // Customer cancelling own placed order
        isCustomer() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.status == 'placed' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelReason', 'cancelledBy', 'cancelledAt', 'statusHistory', 'updatedAt'
        ])
      ) || (
        // Agent transitioning assigned order or updating checklist/empties/QR
        isAgent() &&
        resource.data.agentId == request.auth.uid &&
        (
          (resource.data.status in ['placed', 'packed'] && request.resource.data.status == 'out_for_delivery') ||
          (resource.data.status == 'out_for_delivery' && request.resource.data.status == 'delivered') ||
          (request.resource.data.status == resource.data.status)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'pickedUpAt', 'deliveredAt', 'statusHistory', 'updatedAt', 'emptyCansCollected', 'checkedItems', 'paymentMethod', 'qrId', 'qrLabel'
        ])
      );

      allow delete: if !isSignedIn() || isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if !isSignedIn() || isAdmin() || (isSignedIn() && request.auth.uid == resource.data.toUid);

      allow update: if !isSignedIn() || isAdmin() || (
        isSignedIn() &&
        request.auth.uid == resource.data.toUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );

      allow create: if true;

      allow delete: if !isSignedIn() || isAdmin();
    }

    // Development PIN-help inbox; production submissions must be server-validated.
    match /account_help/{phone} { allow read, write: if true; }

    // ─── Counters ──────────────────────────────────────────────────
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Legacy agents collection support
    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
