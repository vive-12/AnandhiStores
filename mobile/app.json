{
  "expo": {
    "name": "Anandhi Stores",
    "slug": "anandhi-stores",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anandhistores.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Anandhi Stores needs your location to set your doorstep delivery address."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123524"
      },
      "package": "com.anandhistores.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Anandhi Stores needs your location to set your doorstep delivery address."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#123524"
        }
      ]
    ],
    "scheme": "anandhistores",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89170e22-3b73-4828-a94e-172135ffe4f9"
      }
    },
    "owner": "shivani2"
  }
}
